@page "/Catalog"
@using Microsoft.AspNetCore.Components.Forms
@using sharpness_sharp.Components.UIComponents
@using sharpness_sharp.Data
@using sharpness_sharp.Data.Models
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@rendermode InteractiveServer
@inject ApplicationAuthDbContext _dbService

<div class="grid grid-cols-4 gap-4 p-4 bg-gray-100 min-h-screen">
    <button @onclick="MostrarMensaje" class="ui-btn ui-btn-primary">
        Púlsame
    </button>

    @foreach (var mensaje in lstMensajes)
    {
        <p class="ui-btn ui-btn-primary">@mensaje</p>
    }

    @foreach (Cafe cafe in lstCafes)
{
    <div class="border rounded p-4">
        <CoffeeCard Imagen="@cafe.Imagen"
                    DescripcionCafe="@cafe.DescripcionCafe"
                    NombreCafe="@cafe.NombreCafe"
                    PrecioCafe="@cafe.PrecioCafe" />

        <button type="button"
                class="ui-btn ui-btn-primary"
                @onclick="() => SeleccionarCafe(cafe)">
            Editar
        </button>
    </div>
}
</div>
@if (editado != null)
{
    <h2>Editar café</h2>

    <EditForm Model="@editado"
              FormName="editar-cafe"
              OnSubmit="ActualizarCafe">

        <div class="mb-4">
            <label>Nombre del café:</label>

            <InputText @bind-Value="editado.NombreCafe"
                       class="border-2 px-2" />
        </div>

        <div class="mb-4">
            <label>Precio del café:</label>

            <InputNumber @bind-Value="editado.PrecioCafe"
                         class="border-2 px-2" />
        </div>

        <button type="submit" class="ui-btn ui-btn-primary">
            Guardar cambios
        </button>

        <button type="button" @onclick="CancelarEdicion">
            Cancelar
        </button>
    </EditForm>
}

@if (!string.IsNullOrEmpty(mensajeActualizacion))
{
    <p>@mensajeActualizacion</p>
}

<EditForm FormName="agregar-cafe"
          Model="@newCafe"
          OnSubmit="AgregarCafe">

    <InputText @bind-Value="newCafe.NombreCafe"
               class="border-2 px-2"
               placeholder="Introduce el nombre del café" />

    <InputNumber @bind-Value="newCafe.PrecioCafe"
                 class="border-2 px-2"
                 placeholder="Introduce el precio del café" />

    <button type="submit">Guardar</button>
</EditForm>

@code {
    private List<string> lstMensajes = new();
    private List<Cafe> lstCafes = new();
    private Cafe newCafe = new();

    private void MostrarMensaje()
    {
        lstCafes.Add(new Cafe());
    }

    protected override Task OnInitializedAsync()
    {
        lstCafes = _dbService.Cafes.ToList();

        return Task.CompletedTask;
    }

    private Task AgregarCafe()
    {
        _dbService.Cafes.Add(newCafe);
        _dbService.SaveChanges();

        lstCafes.Add(newCafe);
        newCafe = new();

        return Task.CompletedTask;
    }
    private Cafe? editado;
private string mensajeActualizacion = "";

private void SeleccionarCafe(Cafe cafe)
{
    // copiamos los datos al formulario
    editado = new Cafe
    {
        Id = cafe.Id,
        NombreCafe = cafe.NombreCafe,
        PrecioCafe = cafe.PrecioCafe
    };

    mensajeActualizacion = "";
}

private void ActualizarCafe()
{
    if (editado == null)
    {
        return;
    }

    // buscamos el objeto original que EF está siguiendo
    Cafe? cafe = lstCafes.FirstOrDefault(c => c.Id == editado.Id);

    if (cafe == null)
    {
        mensajeActualizacion = "No se encontró el café.";
        return;
    }

    // asignamos los nuevos valores al objeto original
    cafe.NombreCafe = editado.NombreCafe;
    cafe.PrecioCafe = editado.PrecioCafe;

    // guardamos los cambios en la base de datos
    _dbService.SaveChanges();

    editado = null;
    mensajeActualizacion = "Café actualizado correctamente.";
}

private void CancelarEdicion()
{
    editado = null;
    mensajeActualizacion = "";
}
}