@page "/Catalog"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using sharpness_sharp.Components.UIComponents
@using sharpness_sharp.Data
@using sharpness_sharp.Data.Models
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@rendermode InteractiveServer
@inject ApplicationAuthDbContext _dbService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Catálogo de productos</PageTitle>

<div class="mx-auto flex max-w-7xl flex-col gap-6 pb-8">
    <header>
        <h1 class="text-3xl font-bold text-stone-900">Catálogo de productos</h1>
        <p class="mt-2 text-stone-600">Agrega los datos de un café y consulta los productos del catálogo.</p>
    </header>

    <section class="ui-panel" aria-labelledby="agregar-producto">
        <h2 id="agregar-producto" class="ui-section-title">Agregar producto</h2>
        <p class="mt-1 mb-5 text-sm text-stone-600">Completa el nombre, el precio y la descripción. La imagen es opcional.</p>
        <EditForm @key="newCafe" FormName="agregar-cafe" Model="@newCafe" OnValidSubmit="AgregarCafe">
            <DataAnnotationsValidator />
            <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                <div class="ui-field">
                    <label for="nombre-cafe" class="ui-label">Nombre del producto</label>
                    <InputText id="nombre-cafe" @bind-Value="newCafe.NombreCafe" class="ui-input" placeholder="Ej. Café de especialidad" />
                    <ValidationMessage For="@(() => newCafe.NombreCafe)" />
                </div>
                <div class="ui-field">
                    <label for="precio-cafe" class="ui-label">Precio</label>
                    <InputNumber id="precio-cafe" @bind-Value="newCafe.PrecioCafe" class="ui-input" min="0.01" step="0.01"
                                 placeholder="Ej. 25,50" ParsingErrorMessage="Introduce un precio válido." />
                    <ValidationMessage For="@(() => newCafe.PrecioCafe)" />
                </div>
                <div class="ui-field md:col-span-2">
                    <label for="descripcion-cafe" class="ui-label">Descripción</label>
                    <InputTextArea id="descripcion-cafe" @bind-Value="newCafe.DescripcionCafe" class="ui-input" rows="3"
                                   placeholder="Describe el sabor, el origen o la presentación del producto." />
                    <ValidationMessage For="@(() => newCafe.DescripcionCafe)" />
                </div>
                <div class="ui-field md:col-span-2">
                    <label for="imagen-cafe" class="ui-label">Enlace de la imagen (opcional)</label>
                    <InputText id="imagen-cafe" @bind-Value="newCafe.Imagen" class="ui-input"
                               placeholder="https://ejemplo.com/cafe.jpg" aria-describedby="ayuda-imagen" />
                    <p id="ayuda-imagen" class="text-sm text-stone-500">Pega la dirección de una imagen del producto.</p>
                    <ValidationMessage For="@(() => newCafe.Imagen)" />
                </div>
            </div>
            <div class="mt-5 flex justify-end">
                <button type="submit" class="ui-btn ui-btn-primary">Guardar producto</button>
            </div>
        </EditForm>
    </section>

    @if (!string.IsNullOrEmpty(mensajeActualizacion))
    {
        <p class="ui-alert ui-alert-info" role="status">@mensajeActualizacion</p>
    }

    <section aria-labelledby="productos-catalogo">
        <div class="mb-4 flex items-center justify-between gap-3">
            <h2 id="productos-catalogo" class="ui-section-title">Productos del catálogo</h2>
            <span class="text-sm text-stone-500">@lstCafes.Count productos</span>
        </div>
        @if (lstCafes.Count == 0)
        {
            <p class="ui-panel text-stone-600">Todavía no hay productos. Agrega el primero con el formulario de arriba.</p>
        }
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-4">
            @foreach (Cafe cafe in lstCafes)
            {
                <CoffeeCard @key="cafe"
                            Id="@cafe.Id"
                            Imagen="@cafe.Imagen"
                            DescripcionCafe="@cafe.DescripcionCafe"
                            NombreCafe="@cafe.NombreCafe"
                            PrecioCafe="@cafe.PrecioCafe"
                            EnviarNotificacionActualizacion="ActualizarCafe"
                            EnviarNotificacionEliminacion="EliminarCafe" />
            }
        </div>
    </section>
</div>

@code {

    private List<Cafe> lstCafes = new();
    private NuevoCafe newCafe = new();

    private sealed class NuevoCafe
    {
        [Required(ErrorMessage = "Introduce el nombre del producto.")]
        public string? NombreCafe { get; set; }

        [Required(ErrorMessage = "Introduce una descripción del producto.")]
        public string? DescripcionCafe { get; set; }

        [Required(ErrorMessage = "Introduce el precio del producto.")]
        [Range(typeof(decimal), "0.01", "79228162514264337593543950335", ErrorMessage = "El precio debe ser mayor que cero.", ParseLimitsInInvariantCulture = true)]
        public decimal? PrecioCafe { get; set; }

        [Url(ErrorMessage = "Introduce un enlace válido para la imagen (https://...).")]
        public string? Imagen { get; set; }
    }

    protected override Task OnInitializedAsync()
    {
        lstCafes = _dbService.Cafes.ToList()
            .Where(cafe => !string.IsNullOrWhiteSpace(cafe.NombreCafe)
                || !string.IsNullOrWhiteSpace(cafe.DescripcionCafe)
                || !string.IsNullOrWhiteSpace(cafe.Imagen)
                || cafe.PrecioCafe != 0)
            .ToList();

        return Task.CompletedTask;
    }

    private Task AgregarCafe()
    {
        var cafe = new Cafe
        {
            NombreCafe = newCafe.NombreCafe!.Trim(),
            DescripcionCafe = newCafe.DescripcionCafe!.Trim(),
            PrecioCafe = newCafe.PrecioCafe!.Value,
            Imagen = string.IsNullOrWhiteSpace(newCafe.Imagen) ? null : newCafe.Imagen.Trim()
        };
        _dbService.Cafes.Add(cafe);
        _dbService.SaveChanges();

        lstCafes.Add(cafe);
        newCafe = new();
        mensajeActualizacion = "Producto agregado correctamente.";

        return Task.CompletedTask;
    }
    private string mensajeActualizacion = "";

    private async Task<bool> PuedeModificar()
    {
        var estado = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (estado.User.Identity?.IsAuthenticated == true && estado.User.IsInRole("Admin"))
        {
            return true;
        }

        mensajeActualizacion = "No tienes permisos para modificar.";
        return false;
    }

    private async Task ActualizarCafe(Cafe actualizado)
    {
        if (!await PuedeModificar()) return;

        Cafe? cafe = lstCafes.FirstOrDefault(c => c.Id == actualizado.Id);
        if (cafe == null)
        {
            mensajeActualizacion = "No se encontró el café.";
            return;
        }

        cafe.Imagen = actualizado.Imagen;
        cafe.NombreCafe = actualizado.NombreCafe;
        cafe.DescripcionCafe = actualizado.DescripcionCafe;
        cafe.PrecioCafe = actualizado.PrecioCafe;
        _dbService.SaveChanges();
        mensajeActualizacion = "Café actualizado correctamente.";
    }

    private async Task EliminarCafe(int id)
    {
        if (!await PuedeModificar()) return;

        Cafe? cafe = lstCafes.FirstOrDefault(c => c.Id == id);
        if (cafe == null)
        {
            mensajeActualizacion = "No se encontró el café.";
            return;
        }

        _dbService.Cafes.Remove(cafe);
        _dbService.SaveChanges();
        lstCafes.Remove(cafe);
        mensajeActualizacion = "Café eliminado correctamente.";
    }
}
